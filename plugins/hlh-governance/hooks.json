{
  "description": "Synchronous protected-action candidate guard for HLH governance.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/protected-action-guard.py",
            "timeout": 5,
            "statusMessage": "checking HLH protected-action boundary"
          }
        ]
      }
    ]
  }
}
